{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaytwmouneh",
  "compatibility_date": "2026-10-01",
  "main": "./worker/product-seo.mjs",
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/product/*", "/ar/product/*", "/fr/product/*"]
  },
  "previews": {}
}
