{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaytwmouneh",
  "compatibility_date": "2026-10-05",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/shop",
      "/gift",
      "/recipes",
      "/about",
      "/contact",
      "/privacy",
      "/terms",
      "/products",
      "/products/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  }
}
