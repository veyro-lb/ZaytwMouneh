{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaytwmouneh",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/products/*"
    ]
  },
  "main": "./worker.js"
}
